# Copy to .env for: docker compose --profile full up --build

DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:8080

DB_ENGINE=postgres
POSTGRES_DB=aqualedger360
POSTGRES_USER=aqualedger
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

SEED_DEMO_ON_START=true
GUNICORN_WORKERS=2
